# Local development. Copy to `.env` at the repo root — both the backend (compose
# interpolation) and the frontend (vite.config.ts raises envDir to the repo root) read it.

# --- Backend ---
# 7678 = P-O-S-T on a phone keypad (the web side is 2564 = B-L-O-G). Distinctive on purpose:
# it stays clear of 8080/1214 (the sibling cosimosi stack) and of every common dev default.
# Containers and production stacks still use 8080 internally — compose maps 7678 → 8080.
# This value only matters for a host-side `cd backend && go run ./cmd/api`.
PORT=7678
# CORS_ORIGIN is set in docker-compose.yml for local dev; only production stacks
# need it in an .env (see .env.production.example).

# No trusted proxy in local development: use the direct TCP peer and ignore any
# client-supplied forwarding header.
CLIENT_IP_HEADER=

# SQLite file. Relative paths resolve against the process working directory, so the
# default puts it at backend/data/postpilot.db for a host-side `go run ./cmd/api`
# (gitignored). The compose service and production stacks override it.
DB_PATH=data/postpilot.db

# --- Transactional mail ---
# Local development logs bilingual plain-text messages instead of contacting a provider.
MAIL_DRIVER=log
RESEND_API_KEY=
MAIL_FROM=

# --- Google sign-in (optional; set all three or leave all empty) ---
# The secret is backend-only. The client ID is public and is also baked into the web
# bundle; the API refuses a half-configured backend pair.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# --- Billing (optional; set all four or leave all empty) ---
# The Toss client key is public and mirrored into the Vite bundle. The secret and exchange
# rate key stay backend-only; a partial server-side trio is rejected at boot.
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=
VITE_TOSS_CLIENT_KEY=
EXIM_API_KEY=

# --- Frontend (baked in at BUILD time — public values only, never secrets) ---
# Dev leaves this empty: Vite proxies /api → http://localhost:7678 (vite.config.ts).
# A production/preview build needs the real backend origin.
VITE_API_URL=

# --- Object storage (photos) ---
# The API refuses to boot without these: a missing value would surface as a failed
# upload the moment a user picks a photo, which is worse than not starting.
#
# Local dev runs MinIO (S3-compatible) in docker-compose.yml. Production points the
# SAME variables at Cloudflare R2 — that is the whole reason for using the S3 API.
#
# Two endpoints, because a presigned URL's signature covers the Host header: the API
# reaches MinIO by its compose service name, the browser reaches it on the host.
# In production both are the R2 endpoint, so R2_PUBLIC_ENDPOINT is left unset there.
R2_ENDPOINT=http://localhost:9000
R2_PUBLIC_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=postpilot
R2_SECRET_ACCESS_KEY=postpilot-dev-secret
R2_BUCKET=postpilot

# How often unconfirmed uploads and stray objects are swept. The PRD leaves the cadence
# undecided (§9.5); daily is provisional.
ORPHAN_SWEEP_INTERVAL=24h

# Transient clip input leases; no source video is retained as a project asset.
CLIP_SOURCE_BATCH_TTL=6h
CLIP_QUOTE_TTL=5m
CLIP_SOURCE_SWEEP_INTERVAL=10m
CLIP_WORK_ROOT=/tmp/postpilot-clip-work
CLIP_WORK_STALE_AGE=6h
CLIP_MEDIA_TIMEOUT=15m
CLIP_FFMPEG_PATH=/usr/local/bin/ffmpeg
CLIP_FFPROBE_PATH=/usr/local/bin/ffprobe
CLIP_RESVG_PATH=/usr/local/bin/resvg
CLIP_FONT_PATH=/usr/share/postpilot-fonts/pretendard/PretendardVariable.ttf
# The secondary face: the hook title and 크게 강조 are set in Paperlogy 8 ExtraBold.
CLIP_FONT_PAPERLOGY_PATH=/usr/share/postpilot-fonts/paperlogy/Paperlogy-8ExtraBold.ttf
# Optional trusted SVG preset directory, snapshotted at startup; empty uses bundled assets.
CLIP_OVERLAY_DIR=

# --- Paired Mac publishing (server-owned queue; no Naver credentials here) ---
PUBLISH_PAIRING_TTL=10m
PUBLISH_MAX_PENDING_PAIRINGS=8
PUBLISH_LEASE_TTL=45s
PUBLISH_ASSET_URL_TTL=10m
PUBLISH_ORPHAN_SWEEP_INTERVAL=24h
PUBLISH_ORPHAN_MIN_AGE=1h
# Minimum spacing between last_seen_at writes per agent. The refresh lands on the poll
# after the interval elapses, so keep this plus the agent's 5s poll below the frontend's
# PUBLISH_AGENT_STALE_MS (30s) or a live agent renders as offline.
PUBLISH_AGENT_HEARTBEAT_INTERVAL=15s

# --- Post templates (템플릿) ---
# Field ceilings in Unicode characters. The backend validates; the frontend mirrors the three
# field ceilings only for live counters, so those must be raised together.
TEMPLATE_NAME_MAX_CHARS=40
TEMPLATE_DESCRIPTION_MAX_CHARS=200
TEMPLATE_BODY_MAX_CHARS=4000
VITE_TEMPLATE_NAME_MAX_CHARS=40
VITE_TEMPLATE_DESCRIPTION_MAX_CHARS=200
VITE_TEMPLATE_BODY_MAX_CHARS=4000
# How many templates one account may hold, and how many nodes one expanded template may reach
# before a generation is refused. Both stay backend-only: the expansion bound depends on the
# post's photo count, which the template editor cannot know.
TEMPLATE_MAX_PER_ACCOUNT=50
TEMPLATE_MAX_REPEAT_EXPANSION=40

# How many photos one photo position may place side by side in a row. Four is what still
# reads on a 360 px phone; the browser mirrors it as VITE_TEMPLATE_PHOTO_ROW_MAX, so both
# sides have to move together or a body the builder writes is refused on save.
TEMPLATE_PHOTO_ROW_MAX=4
VITE_TEMPLATE_PHOTO_ROW_MAX=4

# The data fields a template may ask the post's author for (TEMPLATE-43): a field's title, one
# answer's text, and how many fields one body may declare. All three are mirrored in the
# browser — the first two as live counters, the third as the refusal the builder states — so
# both sides have to move together.
TEMPLATE_ASK_LABEL_MAX_CHARS=40
TEMPLATE_ASK_VALUE_MAX_CHARS=500
TEMPLATE_ASK_MAX_PER_BODY=10
VITE_TEMPLATE_ASK_LABEL_MAX_CHARS=40
VITE_TEMPLATE_ASK_VALUE_MAX_CHARS=500
VITE_TEMPLATE_ASK_MAX_PER_BODY=10

# One writing guideline's text ceiling, plus how many an account may hold. Every applicable
# guideline enters every prompt, so the count cap is a prompt-size guard and stays backend-only.
GUIDELINE_TEXT_MAX_CHARS=300
GUIDELINE_MAX_PER_ACCOUNT=100
# How many pending guideline candidates an account may hold. Recording stops at the bound
# instead of evicting, so nothing the user might still approve is dropped. Backend-only.
GUIDELINE_CANDIDATE_MAX_PENDING=50
VITE_GUIDELINE_TEXT_MAX_CHARS=300

# --- Model providers (backend/config/providers.yaml) ---
# The yaml names the env var each provider's key is read from (`api_key_env`), so the
# names below are whatever the yaml says — these are the ones the shipped file uses. An
# unset key does not stop the API: that provider's models show as disabled in the
# dropdowns with the reason, and everything else works.
OPENROUTER_API_KEY=
# Where the registry is read from. Default is relative to the API's working directory
# (backend/config/providers.yaml here; /app/config/providers.yaml in the dev container).
# PROVIDERS_CONFIG=config/providers.yaml

# Photos sent to one observation-model call. Smaller batches isolate model mistakes;
# larger batches reduce provider round trips.
OBSERVE_BATCH_SIZE=4

# Video attachments (VIDEO-3). The three ceilings together are what keeps one observation
# call inside the credit hold's prompt assumption — video tokenizes by DURATION, so raising
# either of these reopens the hold's sizing. The browser mirrors them through
# VITE_UPLOAD_MAX_VIDEOS_PER_POST and VITE_VIDEO_MAX_SECONDS, so both sides move together.
UPLOAD_MAX_VIDEOS_PER_POST=3
VIDEO_MAX_SECONDS=60
# The browser's copy of the same three, plus the container list it sorts a pick by. A clip is
# uploaded exactly as picked — nothing converts it — so these are the whole of what the picker
# can refuse before the bytes leave the device.
VITE_UPLOAD_MAX_VIDEOS_PER_POST=3
VITE_UPLOAD_MAX_VIDEO_MB=200
VITE_VIDEO_MAX_SECONDS=60

# The completion cap sent when a caller expresses no budget of its own, and the ceiling every
# per-stage budget is bounded by. Reasoning and visible output share it, so raising it hands a
# reasoning model that ignores its effort more room to fill rather than producing a longer
# post. Change it only with measurements of this installation's own models.
LLM_MAX_TOKENS_DEFAULT=8192

# Private experiment input/output remains until a verdict, then for this retention
# window. The sweep only clears payloads; leaderboard/accounting metadata remains.
EXPERIMENT_CONTENT_RETENTION=720h
EXPERIMENT_SWEEP_INTERVAL=24h
