# Local development. Copy to `.env` at the repo root — both the backend (compose
# interpolation) and the frontend (vite.config.ts raises envDir to the repo root) read it.

# --- Backend ---
# 7678 = P-O-S-T on a phone keypad (the web side is 2564 = B-L-O-G). Distinctive on purpose:
# it stays clear of 8080/1214 (the sibling cosimosi stack) and of every common dev default.
# Containers and production stacks still use 8080 internally — compose maps 7678 → 8080.
# This value only matters for a host-side `cd backend && go run ./cmd/api`.
PORT=7678
# CORS_ORIGIN is set in docker-compose.yml for local dev; only production stacks
# need it in an .env (see .env.production.example).

# SQLite file. Relative paths resolve against the process working directory, so the
# default puts it at backend/data/postpilot.db for a host-side `go run ./cmd/api`
# (gitignored). The compose service and production stacks override it.
DB_PATH=data/postpilot.db

# --- Frontend (baked in at BUILD time — public values only, never secrets) ---
# Dev leaves this empty: Vite proxies /api → http://localhost:7678 (vite.config.ts).
# A production/preview build needs the real backend origin.
VITE_API_URL=

# --- Object storage (photos) ---
# The API refuses to boot without these: a missing value would surface as a failed
# upload the moment a user picks a photo, which is worse than not starting.
#
# Local dev runs MinIO (S3-compatible) in docker-compose.yml. Production points the
# SAME variables at Cloudflare R2 — that is the whole reason for using the S3 API.
#
# Two endpoints, because a presigned URL's signature covers the Host header: the API
# reaches MinIO by its compose service name, the browser reaches it on the host.
# In production both are the R2 endpoint, so R2_PUBLIC_ENDPOINT is left unset there.
R2_ENDPOINT=http://localhost:9000
R2_PUBLIC_ENDPOINT=http://localhost:9000
R2_ACCESS_KEY_ID=postpilot
R2_SECRET_ACCESS_KEY=postpilot-dev-secret
R2_BUCKET=postpilot

# How often unconfirmed uploads and stray objects are swept. The PRD leaves the cadence
# undecided (§9.5); daily is provisional.
ORPHAN_SWEEP_INTERVAL=24h

# --- Model providers (backend/config/providers.yaml) ---
# The yaml names the env var each provider's key is read from (`api_key_env`), so the
# names below are whatever the yaml says — these are the ones the shipped file uses. An
# unset key does not stop the API: that provider's models show as disabled in the
# dropdowns with the reason, and everything else works.
OPENROUTER_API_KEY=
# Where the registry is read from. Default is relative to the API's working directory
# (backend/config/providers.yaml here; /app/config/providers.yaml in the dev container).
# PROVIDERS_CONFIG=config/providers.yaml

# Photos sent to one observation-model call. Smaller batches isolate model mistakes;
# larger batches reduce provider round trips.
OBSERVE_BATCH_SIZE=4

# Private experiment input/output remains until a verdict, then for this retention
# window. The sweep only clears payloads; leaderboard/accounting metadata remains.
EXPERIMENT_CONTENT_RETENTION=720h
EXPERIMENT_SWEEP_INTERVAL=24h
