node_modules/
dist/
.env
.env.local
*.log

# Go
backend/bin/
agent/bin/
backend/tmp/
backend/data/
*.exe
# Container-mounted Go caches (docker compose build/test)
.gocache/
.gomod/

# Editor
.vscode/
.idea/
.DS_Store

# Clip preview generator output (the generators themselves are tracked)
tmp/gallery/*.svg
tmp/gallery/*.png
tmp/gallery/*.ttf
tmp/gallery/index.html

# Footage preview generator output (the generator itself is tracked)
tmp/footage/*.mp4
tmp/footage/*.jpg
tmp/footage/*.png

# Release QA render output (the harness itself is tracked)
tmp/release-qa/clips/*.mp4

# Python bytecode from the deploy tests (the tests themselves are tracked)
__pycache__/
tmp/caption-styles/*.mp4
tmp/caption-styles/stills/*.png
tmp/caption-styles/fonts/*.png
