# Per-environment stack .env on the VPS: /srv/postpilot-staging/.env and
# /srv/postpilot-prod/.env (chmod 600, never committed). docker-compose.prod.yml
# reads this file via `env_file: .env`.

# Written by the deploy workflow on every rollout — the commit SHA of the image to run.
IMAGE_TAG=

PORT=8080

# SQLite file inside the container. docker-compose.prod.yml mounts the stack's
# ./data directory there (uid 65532 — see DEPLOY.md §4).
DB_PATH=/data/postpilot.db

# This stack's DNS alias on the shared `edge` docker network. Caddy proxies to it,
# so it MUST match deploy/edge/Caddyfile: postpilot-api-staging | postpilot-api-prod.
API_UPSTREAM=postpilot-api-prod

# Browser origin allowed to call this API (the frontend for THIS environment).
# The Connect CORS layer allows exactly this one origin.
CORS_ORIGIN=https://postpilot.haeram.me

# --- Cloudflare R2 (photos) ---
# The API refuses to boot without these. Create the bucket and an API token scoped to
# it (DEPLOY.md §3), and set the bucket's CORS rule — without it the browser's direct
# PUT fails silently while every server-side step reports success.
#
# R2_PUBLIC_ENDPOINT is intentionally absent: the browser and the API use the same R2
# endpoint, so it defaults to R2_ENDPOINT. It exists only for split-network dev.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=postpilot-prod

# Orphan sweep cadence (PRD §9.5 leaves it undecided; daily is provisional).
ORPHAN_SWEEP_INTERVAL=24h

# --- Model providers ---
# The image carries its providers.yaml at /config/providers.yaml (PROVIDERS_CONFIG is set
# in the Dockerfile). The yaml names the env var each provider's key is read from; an
# unset key leaves that provider's models disabled in the dropdowns, nothing more.
OPENROUTER_API_KEY=

# Photos sent to one observation-model call. Keep this aligned with the provider's
# image limits; four is the tested default.
OBSERVE_BATCH_SIZE=4

# Model-experiment payload retention and cleanup cadence. Verdict/model/usage metadata
# remains for the private leaderboard until account deletion.
EXPERIMENT_CONTENT_RETENTION=720h
EXPERIMENT_SWEEP_INTERVAL=24h
