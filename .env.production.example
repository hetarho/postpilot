# Per-environment stack .env on the VPS: /srv/postpilot-staging/.env and
# /srv/postpilot-prod/.env (chmod 600, never committed). docker-compose.prod.yml
# reads this file via `env_file: .env`.

# Written by the deploy workflow on every rollout — the commit SHA of the image to run.
IMAGE_TAG=

PORT=8080

# SQLite file inside the container. docker-compose.prod.yml mounts the stack's
# ./data directory there (uid 65532 — see DEPLOY.md §4).
DB_PATH=/data/postpilot.db

# This stack's DNS alias on the shared `edge` docker network. Caddy proxies to it,
# so it MUST match deploy/edge/Caddyfile: postpilot-api-staging | postpilot-api-prod.
API_UPSTREAM=postpilot-api-prod

# Browser origin allowed to call this API (the frontend for THIS environment).
# The Connect CORS layer allows exactly this one origin.
CORS_ORIGIN=https://postpilot.haeram.me

# Shared edge Caddy is the only ingress, so its rightmost appended address is trusted
# for the public-auth per-IP throttle.
CLIENT_IP_HEADER=X-Forwarded-For

# --- Transactional mail ---
# Resend requires a key and a sender on a verified domain. The API refuses to boot when
# either placeholder remains empty while MAIL_DRIVER=resend.
MAIL_DRIVER=resend
RESEND_API_KEY=
MAIL_FROM=

# --- Google sign-in (optional) ---
# GOOGLE_CLIENT_SECRET stays in the stack only. VITE_GOOGLE_CLIENT_ID must also be set
# in the Cloudflare Worker build variables so the matching button is included.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# --- Billing (optional; all empty disables writes and quotes) ---
TOSS_SECRET_KEY=
TOSS_CLIENT_KEY=
VITE_TOSS_CLIENT_KEY=
EXIM_API_KEY=

# --- Cloudflare R2 (photos) ---
# The API refuses to boot without these. Create the bucket and an API token scoped to
# it (DEPLOY.md §3), and set the bucket's CORS rule — without it the browser's direct
# PUT fails silently while every server-side step reports success.
#
# R2_PUBLIC_ENDPOINT is intentionally absent: the browser and the API use the same R2
# endpoint, so it defaults to R2_ENDPOINT. It exists only for split-network dev.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=postpilot-prod

# Orphan sweep cadence (PRD §9.5 leaves it undecided; daily is provisional).
ORPHAN_SWEEP_INTERVAL=24h

# Transient clip input leases; boot and periodic sweeps retry failed deletion.
CLIP_SOURCE_BATCH_TTL=6h
CLIP_SOURCE_SWEEP_INTERVAL=10m
CLIP_WORK_ROOT=/tmp/postpilot-clip-work
CLIP_WORK_STALE_AGE=6h
CLIP_MEDIA_TIMEOUT=15m
CLIP_FFMPEG_PATH=/usr/local/bin/ffmpeg
CLIP_FFPROBE_PATH=/usr/local/bin/ffprobe

# Paired Mac publishing queue. Naver login/cookies and the raw agent token stay on
# the Mac; these values tune only the server-owned device code, lease and cleanup.
PUBLISH_PAIRING_TTL=10m
PUBLISH_MAX_PENDING_PAIRINGS=8
PUBLISH_LEASE_TTL=45s
PUBLISH_ASSET_URL_TTL=10m
PUBLISH_ORPHAN_SWEEP_INTERVAL=24h
PUBLISH_ORPHAN_MIN_AGE=1h
# Minimum spacing between last_seen_at writes per agent. The refresh lands on the poll
# after the interval elapses, so keep this plus the agent's 5s poll below the frontend's
# PUBLISH_AGENT_STALE_MS (30s) or a live agent renders as offline.
PUBLISH_AGENT_HEARTBEAT_INTERVAL=15s

# --- Model providers ---
# The image carries its providers.yaml at /config/providers.yaml (PROVIDERS_CONFIG is set
# in the Dockerfile). The yaml names the env var each provider's key is read from; an
# unset key leaves that provider's models disabled in the dropdowns, nothing more.
OPENROUTER_API_KEY=

# Photos sent to one observation-model call. Keep this aligned with the provider's
# image limits; four is the tested default.
OBSERVE_BATCH_SIZE=4

# Video attachments (VIDEO-3). The three ceilings together are what keeps one observation
# call inside the credit hold's prompt assumption — video tokenizes by DURATION, so raising
# either of these reopens the hold's sizing. The browser mirrors them through
# VITE_UPLOAD_MAX_VIDEOS_PER_POST and VITE_VIDEO_MAX_SECONDS, so both sides move together.
UPLOAD_MAX_VIDEOS_PER_POST=3
VIDEO_MAX_SECONDS=60

# Model-experiment payload retention and cleanup cadence. Verdict/model/usage metadata
# remains for the private leaderboard until account deletion.
EXPERIMENT_CONTENT_RETENTION=720h
EXPERIMENT_SWEEP_INTERVAL=24h

# --- Post purpose briefs (용도) ---
# Field ceilings in Unicode characters. The backend validates; the frontend mirrors these
# only for live counters, so the two must be raised together.
PURPOSE_NAME_MAX_CHARS=40
PURPOSE_DESCRIPTION_MAX_CHARS=200
PURPOSE_INSTRUCTIONS_MAX_CHARS=2000
VITE_PURPOSE_NAME_MAX_CHARS=40
VITE_PURPOSE_DESCRIPTION_MAX_CHARS=200
VITE_PURPOSE_INSTRUCTIONS_MAX_CHARS=2000

# --- Post templates (템플릿) ---
# How many photos one photo position may place side by side in a row (TEMPLATE-38). Four is
# what still reads on a 360 px phone. The browser mirrors it as VITE_TEMPLATE_PHOTO_ROW_MAX,
# so both sides have to move together or a body the builder writes is refused on save.
TEMPLATE_PHOTO_ROW_MAX=4
VITE_TEMPLATE_PHOTO_ROW_MAX=4

# The data fields a template may ask the post's author for (TEMPLATE-43): a field's title, one
# answer's text, and how many fields one body may declare. All three are mirrored in the
# browser — the first two as live counters, the third as the refusal the builder states — so
# both sides have to move together.
TEMPLATE_ASK_LABEL_MAX_CHARS=40
TEMPLATE_ASK_VALUE_MAX_CHARS=500
TEMPLATE_ASK_MAX_PER_BODY=10
VITE_TEMPLATE_ASK_LABEL_MAX_CHARS=40
VITE_TEMPLATE_ASK_VALUE_MAX_CHARS=500
VITE_TEMPLATE_ASK_MAX_PER_BODY=10
