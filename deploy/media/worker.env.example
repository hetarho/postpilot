# Copy to worker.env in the stack directory; chmod 600. Never copy the API .env.
# Pin a published 40-character commit SHA, independently of IMAGE_TAG on the VPS.
MEDIA_WORKER_IMAGE_TAG=
# Colocated: http://api:9000. Remote: https://<vps>.<tailnet>.ts.net:9443
MEDIA_API_URL=http://api:9000
# Unique per environment and executor. Match the API's MEDIA_WORKER_CREDENTIALS.
MEDIA_WORKER_ID=prod-cpu-1
MEDIA_WORKER_TOKEN=
MEDIA_ACCEL=cpu
MEDIA_WORKER_CONCURRENCY=1
# Starting limits, not a capacity guarantee for a shared VPS. Run host preflight.
MEDIA_WORKER_CPUS=1.0
MEDIA_WORKER_MEMORY=512m
MEDIA_DRAIN_TIMEOUT=30s
# Seconds; must exceed drain by at least 15 seconds for the final report/reaping.
MEDIA_STOP_TIMEOUT=45
# Named volume only; never use the API's data directory.
CLIP_WORK_ROOT=/var/lib/postpilot-media/work
CLIP_WORK_STALE_AGE=6h
CLIP_MEDIA_TIMEOUT=15m
CLIP_ENCODE_THREADS=1
CLIP_DECODE_THREADS=2
# Tool/font/overlay defaults come from the selected image. Obsolete Pretendard
# paths fail preflight; remove old overrides rather than copying them here.
# Workspace remains bounded at 8 GiB, prepared copies 512 MiB and one active job.
