# Separate least-authority identity on the existing colocated CPU host.
# Copy to analysis-worker.env (chmod600); do not copy API/provider/R2 credentials.
MEDIA_API_URL=http://api:9000
MEDIA_WORKER_ID=prod-analysis-1
MEDIA_WORKER_TOKEN=
MEDIA_WORKER_ROLE=analysis-verification
MEDIA_ACCEL=cpu
MEDIA_WORKER_CONCURRENCY=1
MEDIA_DRAIN_TIMEOUT=30s
MEDIA_STOP_TIMEOUT=45
CLIP_WORK_ROOT=/var/lib/postpilot-media/work
CLIP_WORK_STALE_AGE=6h
CLIP_MEDIA_TIMEOUT=2m
CLIP_ENCODE_THREADS=1
CLIP_DECODE_THREADS=1
# Compose interpolation belongs in the stack's env file:
# ANALYSIS_WORKER_IMAGE_TAG=<verified40-characterSHA>
# ANALYSIS_WORKER_CPUS=0.5
# ANALYSIS_WORKER_MEMORY=256m
