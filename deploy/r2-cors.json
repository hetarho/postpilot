{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://postpilot.<domain>"
        ],
        "methods": [
          "GET",
          "PUT",
          "HEAD"
        ],
        "headers": [
          "content-type",
          "if-none-match",
          "range"
        ]
      },
      "exposeHeaders": [
        "etag",
        "content-range"
      ],
      "maxAgeSeconds": 3600
    }
  ]
}
