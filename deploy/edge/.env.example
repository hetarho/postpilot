# /srv/edge/.env — the shared edge Caddy's variables. DOMAINS ONLY: docker-compose.yml
# injects this whole file into the caddy container (env_file), so nothing secret goes here.
#
# On a VPS shared with other projects this file ALREADY EXISTS and holds their variables.
# Append postpilot's lines to it; do not overwrite it. Every name is prefixed with its
# project so two projects can never resolve a site block to the same address (an
# `ambiguous site definition` rejects the entire config and drops TLS for every project).
#
# The STAGING line stays commented out until the staging fragment is enabled (drop the
# `.disabled` suffix on conf.d/postpilot.staging.caddy.disabled). Set the variable BEFORE
# the rename: an active fragment whose variable is unset breaks the whole box's config.

POSTPILOT_API_DOMAIN_PROD=api.postpilot.example.com
#POSTPILOT_API_DOMAIN_STAGING=api.staging.postpilot.example.com
