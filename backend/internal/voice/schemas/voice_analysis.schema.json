{
  "type": "object",
  "additionalProperties": false,
  "required": ["impression", "tics", "signature_phrases", "examples"],
  "properties": {
    "impression": { "type": "string" },
    "tics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["phrase", "when"],
        "properties": {
          "phrase": { "type": "string" },
          "when": { "type": "string" }
        }
      }
    },
    "signature_phrases": { "type": "array", "items": { "type": "string" } },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "sentence"],
        "properties": {
          "field": { "type": "string", "enum": ["impression", "tics", "signature_phrases"] },
          "sentence": { "type": "string" }
        }
      }
    }
  }
}
