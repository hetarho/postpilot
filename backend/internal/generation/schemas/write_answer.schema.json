{
  "type": "object",
  "additionalProperties": false,
  "required": ["storyline", "title", "summary", "tags", "blocks", "nouns"],
  "properties": {
    "storyline": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "files"],
        "properties": {
          "text": {"type": "string"},
          "files": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "title": {"type": "string"},
    "summary": {"type": "string"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "content", "level", "file", "alt", "caption", "items"],
        "properties": {
          "type": {"type": "string", "enum": ["TEXT", "HEADING", "IMAGE", "VIDEO", "QUOTE", "LIST"]},
          "content": {"type": "string"},
          "level": {"type": "integer"},
          "file": {"type": "string"},
          "alt": {"type": "string"},
          "caption": {"type": "string"},
          "items": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "nouns": {"type": "array", "maxItems": 40, "items": {"type": "string"}}
  }
}
