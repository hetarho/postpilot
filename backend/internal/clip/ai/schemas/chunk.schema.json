{
  "type": "object",
  "additionalProperties": false,
  "required": ["source_id", "chunk_index", "segments"],
  "properties": {
    "source_id": { "type": "string" },
    "chunk_index": { "type": "integer", "minimum": 0 },
    "segments": {
      "type": "array", "minItems": 1, "maxItems": 60,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["start_ms", "end_ms", "event", "action", "motion", "subjects", "speech", "quality", "focal", "scene", "readable_text", "subject", "certainty", "usability"],
        "properties": {
          "start_ms": { "type": "integer" },
          "end_ms": { "type": "integer" },
          "event": { "type": "string", "maxLength": 2000 },
          "action": { "type": "string", "maxLength": 2000 },
          "motion": { "type": "string", "maxLength": 2000 },
          "subjects": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
          "speech": { "type": "string", "maxLength": 2000 },
          "quality": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "focal": {
            "type": "object", "additionalProperties": false, "required": ["x", "y"],
            "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 } }
          },
          "scene": { "type": "string", "enum": ["food", "exterior", "interior", "menu", "person", "product", "scenery"] },
          "readable_text": { "type": "boolean" },
          "certainty": { "type": "string", "enum": ["certain", "uncertain", "unknown"] },
          "usability": { "type": "string", "enum": ["usable", "unusable"] },
          "caption_safe": {
            "type": "array", "maxItems": 4,
            "description": "Factual empty space, not an anchor, style or placement choice.",
            "items": {
              "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
              "properties": {
                "x": { "type": "number", "minimum": 0, "maximum": 1 },
                "y": { "type": "number", "minimum": 0, "maximum": 1 },
                "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
                "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
              }
            }
          },
          "subject": {
            "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
            "properties": {
              "x": { "type": "number", "minimum": 0, "maximum": 1 },
              "y": { "type": "number", "minimum": 0, "maximum": 1 },
              "width": { "type": "number", "minimum": 0, "maximum": 1 },
              "height": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    }
  }
}
