{
  "type": "object", "additionalProperties": false,
  "required": ["ratio", "duration_ms", "hook", "cuts"],
  "properties": {
    "ratio": { "type": "string", "enum": ["vertical", "horizontal", "square"] },
    "hook": { "type": "string", "maxLength": 40 },
    "duration_ms": { "type": "integer", "minimum": 15000, "maximum": 90000 },
    "cuts": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "source_id", "start_ms", "end_ms", "focal", "caption", "chips"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "source_id": { "type": "string" },
          "start_ms": { "type": "integer", "minimum": 0 },
          "end_ms": { "type": "integer", "minimum": 1 },
          "volume": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 },
          "focal": {
            "type": "object", "additionalProperties": false, "required": ["x", "y"],
            "properties": { "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 } }
          },
          "chips": { "type": "array", "maxItems": 2, "items": { "type": "string", "minLength": 1, "maxLength": 20 } },
          "caption": {
            "type": "object", "additionalProperties": false,
            "required": ["text", "start_ms", "end_ms", "short_text", "keyword"],
            "properties": {
              "text": { "type": "string", "maxLength": 500 },
              "start_ms": { "type": "integer", "minimum": 0 },
              "end_ms": { "type": "integer", "minimum": 1 },
              "short_text": { "type": "string", "maxLength": 40 },
              "keyword": { "type": "string", "maxLength": 40 }
            }
          }
        }
      }
    }
  }
}
