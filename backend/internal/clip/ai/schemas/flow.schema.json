{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "storyline",
    "region_slots",
    "ratio",
    "duration_ms",
    "cuts"
  ],
  "properties": {
    "storyline": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "observation_ids"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 1000
          },
          "observation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "region_slots": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slot_id",
          "text",
          "short_text"
        ],
        "properties": {
          "slot_id": {
            "type": "string",
            "maxLength": 64
          },
          "text": {
            "type": "string",
            "maxLength": 500
          },
          "short_text": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    },
    "ratio": {
      "type": "string",
      "enum": [
        "vertical",
        "horizontal",
        "square"
      ]
    },
    "duration_ms": {
      "type": "integer",
      "minimum": 15000,
      "maximum": 60000
    },
    "cuts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source_id",
          "start_ms",
          "end_ms",
          "rate_permille",
          "focal",
          "volume",
          "observation_refs"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "source_id": {
            "type": "string"
          },
          "start_ms": {
            "type": "integer",
            "minimum": 0
          },
          "end_ms": {
            "type": "integer",
            "minimum": 1
          },
          "rate_permille": {
            "type": "integer",
            "enum": [
              500,
              750,
              1000,
              1250,
              1500,
              2000
            ]
          },
          "focal": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "observation_refs": {
            "type": "array",
            "maxItems": 120,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
