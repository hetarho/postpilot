    "executedProbeSource": "import { createRequire } from 'node:module';\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { pathToFileURL } from 'node:url';\nimport { createHash } from 'node:crypto';\nconst root='/Users/ihaelam/project/.haeram-worktrees/postpilot-f6c0250f/browser-media-604-T597-bb89294d';\nconst req=createRequire(root+'/package.json'), front=createRequire(root+'/frontend/package.json');\nconst {chromium}=req('playwright'),{createServer}=await import(pathToFileURL(front.resolve('vite')).href);\nconst probe=`import {BrowserLocalComponents,BrowserCaptionScenePixi,evaluateBrowserFrame} from '@/entities/clip-preview';\nimport {freezeFixture} from '/src/test/browser-media/ink-entry.ts';\nimport {WebGLRenderer,RenderTexture} from 'pixi.js';\nimport {CLIP_DESIGN} from '@/entities/clip-design/@x/clip-preview';\nwindow.emberPhaseProbe=async(fixture,engine)=>{\n const start=performance.now(),snapshot=await freezeFixture(fixture),snapshotFreezeMs=performance.now()-start;\n const dimensions=CLIP_DESIGN.ratios[fixture.ratio].canvas,canvas=new OffscreenCanvas(dimensions.width,dimensions.height),context=canvas.getContext('2d',{willReadFrequently:true});\n const components=new BrowserLocalComponents(snapshot);let renderer,scene,target;const init=performance.now();\n if(engine==='pixi'){renderer=new WebGLRenderer();await renderer.init({canvas:new OffscreenCanvas(dimensions.width,dimensions.height),...dimensions,resolution:1,backgroundAlpha:0});scene=new BrowserCaptionScenePixi(renderer,owner=>components.dropGPU(owner));target=RenderTexture.create(dimensions);}\n const graphicsInitMs=performance.now()-init,phases=[];let warmRasters,effectBounds,peakCPUBytes=0,peakManagedGPUBytes=0,peakShapes=0;\n try{\n  for(let i=0;i<135;i++){\n   const frame=i===0?fixture.frame:32+i-1,t0=performance.now(),resources=await components.prepare(evaluateBrowserFrame(snapshot,frame)),t1=performance.now();\n   try{context.clearRect(0,0,canvas.width,canvas.height);resources.forEach((r,index)=>{if(scene&&r.kind==='scene')scene.render(r.scene,target,index===0);else r.draw(context);});const t2=performance.now();\n    if(renderer)renderer.gl.finish();else context.getImageData(0,0,canvas.width,canvas.height);const t3=performance.now();\n    phases.push({prepareMs:t1-t0,drawSubmitMs:t2-t1,diagnosticCompletionMs:t3-t2,totalMs:t3-t0});\n    effectBounds=resources.find(r=>r.kind==='scene')?.scene.bounds;\n    const c=components.measurements(),g=scene?.measurements();peakCPUBytes=Math.max(peakCPUBytes,c.bytes+c.canvas.groupBytes+c.canvas.effectBytes+c.canvas.tintBytes);peakManagedGPUBytes=Math.max(peakManagedGPUBytes,g?.managedTextureBytes??0);peakShapes=Math.max(peakShapes,g?.dynamicShapes??0);\n    if(i===0)warmRasters=c.rasters;else if(c.rasters!==warmRasters)throw new Error('Ember movement rerasterized text');\n   }finally{resources.forEach(r=>r.close());}\n  }\n  const metric=key=>{const v=phases.slice(1).map(p=>p[key]).sort((a,b)=>a-b);return{p50Ms:v[Math.floor(v.length*.5)],p95Ms:v[Math.floor(v.length*.95)]};};\n  scene?.destroy();components.destroy();if(components.measurements().leases||components.measurements().bytes)throw new Error('Ember phase resources leaked');\n  return{id:fixture.id,engine,frames:phases.length,snapshotFreezeMs,graphicsInitMs,cold:phases[0],warm:Object.fromEntries(Object.keys(phases[0]).map(k=>[k,metric(k)])),warmRasters,effectBounds,peakCPUBytes,peakManagedGPUBytes,peakShapes,cleanup:true,qualification:false};\n }finally{scene?.destroy();target?.destroy(true);renderer?.destroy();components.destroy();canvas.width=canvas.height=0;}\n};`;\nconst server=await createServer({configFile:false,root:root+'/frontend',resolve:{alias:{'@':root+'/frontend/src'}},server:{host:'127.0.0.1',port:0,watch:null,headers:{'Cross-Origin-Opener-Policy':'same-origin','Cross-Origin-Embedder-Policy':'require-corp'}},plugins:[{name:'external-ember-phase-probe',resolveId(id){if(id==='/__ember_phase__.ts')return '\\0ember-phase-probe';},load(id)