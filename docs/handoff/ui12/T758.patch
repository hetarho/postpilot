+  expect(screen.getByRole('button', { name: '바로 만들기' })).toHaveAccessibleDescription(
+    '스토리라인 문구를 바로잡아 주세요.',
+  )
+  await userEvent.click(screen.getByRole('button', { name: '바로잡기' }))
+  expect(fix).toHaveBeenCalledOnce()
+  expect(submit).not.toHaveBeenCalled()
+})
