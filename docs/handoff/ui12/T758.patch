+import { act, renderHook } from '@testing-library/react'
+import { afterEach, expect, it, vi } from 'vitest'
+import { usePreparationClock } from './usePreparationClock'
+
+afterEach(() => vi.useRealTimers())
+
+it('updates at each retained-source deadline and on resume without polling or starting work', () => {
+  vi.useFakeTimers()
+  const start = Date.parse('2026-11-11T00:00:00Z')
+  vi.setSystemTime(start)
+  const deadlines = [new Date(start + 1000).toISOString(), new Date(start + 2000).toISOString()]
+  const view = renderHook(() => usePreparationClock(deadlines))
+  expect(view.result.current).toBe(start)
+  act(() => vi.advanceTimersByTime(1000))
+  expect(view.result.current).toBe(start + 1000)
+  act(() => vi.advanceTimersByTime(1000))
+  expect(view.result.current).toBe(start + 2000)
+  act(() => {
+    vi.setSystemTime(start + 5000)
+    window.dispatchEvent(new Event('focus'))
+  })
+  expect(view.result.current).toBe(start + 5000)
+  view.unmount()
+  expect(vi.getTimerCount()).toBe(0)
+})
diff --git a/frontend/src/widgets/clip-workspace/model/usePreparationClock.ts b/frontend/src/widgets/clip-workspace/model/usePreparationClock.ts
new file mode 100644
index 00000000..fa16384f
--- /dev/null
+++ b/frontend/src/widgets/clip-workspace/model/usePreparationClock.ts
@@ -0,0 +1,25 @@
+import { useEffect, useState } from 'react'
+
+/** One clock for the preparation verdict and its source summary, refreshed at expiry/resume. */
+export function usePreparationClock(expiries: readonly (string | undefined)[]) {
+  const [now, setNow] = useState(Date.now)
+  const next = Math.min(
+    ...expiries.map((value) => Date.parse(value ?? '')).filter((at) => at > now),
+  )
+  useEffect(() => {
+    const refresh = () => setNow(Date.now())
+    const delay = next - Date.now()
+    const timer =
+      Number.isFinite(delay) && delay <= 2 ** 31 - 1
+        ? window.setTimeout(refresh, Math.max(0, delay))
+        : undefined
+    window.addEventListener('focus', refresh)
+    document.addEventListener('visibilitychange', refresh)
+    return () => {
+      window.clearTimeout(timer)
+      window.removeEventListener('focus', refresh)
+      document.removeEventListener('visibilitychange', refresh)
+    }
+  }, [next])
+  return now
+}
