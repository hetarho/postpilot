+import { useTranslation } from 'react-i18next'
+import type { useClipWorkspace } from '../model/useClipWorkspace'
+
+/** Source order, readiness, owner audio choices and optional bindings from their current owner. */
+export function ClipPreparationSources({ sources, ready }: { sources: ReturnType<typeof useClipWorkspace>['sources']; ready: boolean }) {
+  const { t } = useTranslation('clips')
+  const entries = sources.upload.entries
+  const now = Date.now()
+  const unavailable = (entry: (typeof entries)[number]) =>
+    ['expired', 'missing', 'cleanup_pending'].includes(entry.availability ?? '') ||
+    (!!entry.retentionExpiresAt && Date.parse(entry.retentionExpiresAt) <= now)
+  const readyCount = entries.filter(entry => entry.confirmed && !unavailable(entry)).length
+  return <>
+    <p>{t('guide.sourceCount', { count: entries.length, ready: readyCount })}</p>
+    {!ready && <p>{t(entries.length ? 'guide.sourceRefusal' : 'guide.noSources')}</p>}
+    <ol className="space-y-3">
+      {entries.map((entry, index) => {
+        const source = { batchId: entry.batchId ?? '', sourceId: entry.sourceId ?? '', fingerprint: entry.metadata.fingerprint, retainOriginalAudio: entry.retainOriginalAudio ?? false }
+        const item = sources.binding.items.find(item => item.value === sources.binding.value(source))
+        const missing = unavailable(entry)
+        return <li key={entry.metadata.fingerprint}>
+          <p>{t('guide.sourceItem', { position: index + 1, filename: entry.metadata.filename, seconds: entry.metadata.durationMs / 1000, status: t(missing ? 'guide.sourceUnavailable' : entry.confirmed ? 'guide.sourceReady' : 'guide.sourcePending'), sound: t(sources.sound.value(source) ? 'guide.soundOn' : 'guide.soundOff') })}</p>
+          <p>{item ? t('guide.binding', { item: item.label }) : t('guide.noBinding')}</p>
+        </li>
+      })}
+    </ol>
+  </>
+}
