+  await userEvent.click(screen.getByRole('button', { name: '검토' }))
+  const narration = screen.getByRole('region', { name: '더빙 사용' })
+  expect(narration).toHaveTextContent(state === 'confirmed' ? '확정 목소리: 차분한 목소리' : state === 'loading' ? '확정 목소리를 확인하는 중' : state === 'failed' ? '불러오지 못했어요' : '사용할 수 있는 확정 목소리')
+  await userEvent.click(screen.getByRole('button', { name: '스타일' }))
+  await userEvent.click(screen.getByRole('checkbox', { name: '더빙 선택' }))
+  await userEvent.click(screen.getByRole('button', { name: '검토' }))
+  expect(narration).toHaveTextContent('더빙 사용 안 함 · 원본 소리는 소스별 선택을 따라요.')
+})
diff --git a/frontend/src/widgets/clip-workspace/ui/ClipPreparationGuide.test.tsx b/frontend/src/widgets/clip-workspace/ui/ClipPreparationGuide.test.tsx
