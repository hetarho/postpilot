+  expect(within(rows[0]).getByText('항목 연결: 메뉴 · 파스타')).toBeVisible()
+  expect(rows[1]).toHaveTextContent('업로드·준비 대기 · 원본 소리 제외')
+  expect(rows[2]).toHaveTextContent('원본을 다시 선택해 주세요.')
