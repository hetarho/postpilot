+beforeEach(() => { ports.save.mockImplementation(async ({ draft }: { draft: ClipProjectDraft }) => ({ ...project, ...draft })); ports.voices = []; ports.voicePending = false; ports.voiceFailed = false; ports.templatePending = false; ports.templateFailed = false })
+afterEach(() => { discardClipDraftQueues(); vi.clearAllMocks() })
