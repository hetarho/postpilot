{
  "name": "postpilot",
  "version": "0.0.1",
  "private": true,
  "description": "Photos + what happened → a ready-to-paste blog post, per platform",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"pnpm run dev:web\" \"pnpm run dev:api\"",
    "dev:web": "pnpm --filter ./frontend dev",
    "dev:api": "docker compose --profile dev up --build backend",
    "gen": "node scripts/gen.mjs",
    "gen:proto": "node scripts/gen.mjs proto",
    "gen:sql": "node scripts/gen.mjs sql",
    "build:web": "pnpm --filter ./frontend build",
    "build:api": "cd backend && go build -o bin/api ./cmd/api",
    "agent:setup": "cd agent && go run ./cmd/postpilot-agent setup",
    "agent:run": "cd agent && go run ./cmd/postpilot-agent run",
    "agent:diagnostics": "cd agent && go run ./cmd/postpilot-agent diagnostics",
    "agent:build": "cd agent && go build -o bin/postpilot-agent ./cmd/postpilot-agent",
    "agent:install": "cd agent && sh packaging/install.sh",
    "lint": "pnpm --filter ./frontend lint && pnpm run format:check",
    "format:check": "pnpm --filter ./frontend format:check",
    "lint:fsd": "pnpm --filter ./frontend lint:fsd",
    "lint:style": "node scripts/lint-style-escapes.mjs",
    "lint:style:probe": "node scripts/lint-style-escapes.mjs --probe",
    "test": "pnpm --filter ./frontend test",
    "smoke": "docker build --progress=plain --target production -t postpilot:gate -f backend/Dockerfile .",
    "smoke:media": "docker build --progress=plain --target media-smoke -t postpilot:gate-media -f backend/Dockerfile .",
    "smoke:input": "docker build --progress=plain --target clip-input-smoke -t postpilot:gate-input -f backend/Dockerfile .",
    "smoke:release": "docker build --progress=plain --target release-smoke -t postpilot:gate-release -f backend/Dockerfile . && docker run --rm --network none --memory 1g --cpus 2 postpilot:gate-release",
    "docker:gc": "node scripts/docker-gc.mjs",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "haeram-spec-creator": "^0.2.3"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=24"
  }
}
